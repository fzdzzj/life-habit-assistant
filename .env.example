# Local-only configuration template.
# Copy this file to .env and replace the placeholder values before starting the application.
DB_HOST=localhost
DB_PORT=3306
DB_NAME=life_habit_assistant
DB_USERNAME=root
DB_PASSWORD=replace-with-your-local-password
MYSQL_ROOT_PASSWORD=replace-with-a-strong-root-password
# Container MySQL application account (compose only; local Maven runs keep using DB_USERNAME/DB_PASSWORD).
# MySQL image rejects root as MYSQL_USER, so the app connects with this dedicated account.
MYSQL_USER=lha_app
MYSQL_PASSWORD=replace-with-a-strong-app-password
JWT_SECRET=replace-with-a-random-secret-at-least-32-characters-long
JWT_EXPIRATION_HOURS=24
# Set true only for the first migration of an existing manually-created schema.
# Keep false for a new empty database.
FLYWAY_BASELINE_ON_MIGRATE=false

# Docker Compose deployment (docs/deployment.md).
# DB_HOST/DB_PORT are overridden to the compose service name automatically.
# MYSQL_HOST_PORT is the host port mapped to the containerized MySQL (default 3307 to avoid local MySQL).
MYSQL_HOST_PORT=3307
APP_PORT=8080
TZ=Asia/Shanghai

# Optional: registry mirror images for environments without direct Docker Hub
# access (e.g. mainland China). Keep these empty on normal networks.
# Examples:
#   BUILD_IMAGE=docker.m.daocloud.io/library/maven:3.9-eclipse-temurin-21
#   RUNTIME_IMAGE=docker.m.daocloud.io/library/eclipse-temurin:21-jre-jammy
#   MYSQL_IMAGE=docker.m.daocloud.io/library/mysql:8.0
#   BACKUP_IMAGE=docker.m.daocloud.io/library/alpine:3.20
#   PROMETHEUS_IMAGE=docker.m.daocloud.io/prom/prometheus:v2.55.1
#   LOKI_IMAGE=docker.m.daocloud.io/grafana/loki:3.4.2
#   PROMTAIL_IMAGE=docker.m.daocloud.io/grafana/promtail:3.4.2
#   GRAFANA_IMAGE=docker.m.daocloud.io/grafana/grafana:11.6.0
BUILD_IMAGE=
RUNTIME_IMAGE=
MYSQL_IMAGE=
BACKUP_IMAGE=
PROMETHEUS_IMAGE=
LOKI_IMAGE=
PROMTAIL_IMAGE=
GRAFANA_IMAGE=

# Automated MySQL backup (backup container, crond schedule).
BACKUP_CRON=0 3 * * *
BACKUP_KEEP_DAYS=7

# Application log rolling (prod profile; container logs are also rotated by compose).
LOG_FILE=logs/app.log
LOG_MAX_FILE_SIZE=50MB
LOG_MAX_HISTORY=7
LOG_TOTAL_SIZE_CAP=500MB

# Optional monitoring stack (docker compose --profile monitoring up -d).
# Change Grafana admin password before exposing it beyond localhost.
GRAFANA_ADMIN_USER=admin
GRAFANA_ADMIN_PASSWORD=admin
PROMETHEUS_RETENTION=168h
PROMETHEUS_PORT=9090
LOKI_PORT=3100
GRAFANA_PORT=3000

# Optional: OpenAI personalized advice. Disabled by default; leave OPENAI_API_KEY
# and OPENAI_MODEL empty until you are ready to enable it.
AI_ADVICE_ENABLED=false
OPENAI_API_KEY=
OPENAI_MODEL=
OPENAI_BASE_URL=https://api.openai.com/v1
AI_ADVICE_DAILY_LIMIT=3
AI_ADVICE_MONTHLY_LIMIT=30
AI_ADVICE_TIMEOUT_SECONDS=30
AI_ADVICE_CACHE_TTL=10m
AI_ADVICE_CACHE_MAX_SIZE=128

# Optional: multi-turn AI conversation. Uses the same OpenAI key/model/base URL
# and the same daily/monthly quota bucket as the report interpretation above.
AI_CONVERSATION_ENABLED=false
AI_CONVERSATION_CONTEXT_DAYS=7
AI_CONVERSATION_MAX_HISTORY_ROUNDS=10
AI_CONVERSATION_MAX_MESSAGE_LENGTH=2000
AI_CONVERSATION_STREAM_TIMEOUT_SECONDS=300
AI_CONVERSATION_PROMPT_VERSION=v1

# Export file storage: files are no longer kept in the database LONGBLOB.
# local = directory under EXPORT_STORAGE_LOCAL_DIRECTORY (default).
# s3 = S3-compatible object storage; endpoint/access/secret/bucket are required.
EXPORT_STORAGE_TYPE=local
EXPORT_STORAGE_LOCAL_DIRECTORY=./data/exports
# Migrate legacy LONGBLOB export files to storage automatically at startup.
EXPORT_STORAGE_BACKFILL_ENABLED=true
EXPORT_S3_ENDPOINT=
EXPORT_S3_ACCESS_KEY=
EXPORT_S3_SECRET_KEY=
EXPORT_S3_BUCKET=
EXPORT_S3_REGION=us-east-1
